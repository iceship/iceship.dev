{
  "nodeModulesDir": "auto",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "vite",
    "build": "deno task validate:posts && vite build",
    "validate:posts": "deno run --allow-read=posts scripts/validate-posts.ts",
    "optimize:images": "deno run -A scripts/optimize-images.ts",
    "test": "deno test --allow-read --allow-write tests/",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "fmt": {
    "proseWrap": "preserve"
  },
  "exclude": [
    "**/_fresh/*",
    "vite.config.ts",
    "posts/**"
  ],
  "imports": {
    "@/": "./",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@types/prismjs": "npm:@types/prismjs@^1.26.6",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "prismjs": "npm:prismjs@^1.30.0",
    "vite": "npm:vite@^7.1.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "tailwindcss": "npm:tailwindcss@^4.1.10",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.12",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9",
    "marked": "npm:marked@^16.3.0"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  }
}
